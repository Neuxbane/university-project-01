datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  passwordHash String        @map("password_hash")
  name         String
  roleId       Int?          @map("role_id")
  role         String        @default("STAFF")
  roleRel      Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  pickSessions PickSession[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  displayName String           @map("display_name")
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  category    String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MotorcycleType {
  id           Int                    @id @default(autoincrement())
  brand        String                 // Honda, Yamaha, Suzuki, Kawasaki
  model        String
  variant      String
  yearStart    Int                    @map("year_start")
  yearEnd      Int?                   @map("year_end")
  displayName  String                 @map("display_name")
  notes        String?
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at")
  requirements MotorBoltRequirement[]
  packages     Package[]
  pickSessions PickSession[]
  images       MotorcycleImage[]
  models       MotorcycleModel[]
  annotations  PositionAnnotation[]
  boltPositions BoltPosition[]
  closeUpPhotos CloseUpPhoto[]

  @@unique([brand, model, variant, yearStart, yearEnd])
  @@map("motorcycle_types")
}

model MotorcycleImage {
  id               Int            @id @default(autoincrement())
  motorcycleTypeId Int            @map("motorcycle_type_id")
  url              String
  caption          String?
  isPrimary        Boolean        @default(false) @map("is_primary")
  createdAt        DateTime       @default(now()) @map("created_at")
  motorcycleType   MotorcycleType @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)

  @@index([motorcycleTypeId])
  @@map("motorcycle_images")
}

model BoltPosition {
  id               Int                    @id @default(autoincrement())
  motorcycleTypeId Int?                   @map("motorcycle_type_id")
  name             String
  category         String                 // Mesin, Bodi, Pengereman, Rangka, dll.
  sortOrder        Int                    @default(0) @map("sort_order")
  notes            String?
  photoUrl         String?                @map("photo_url")
  motorcycleType   MotorcycleType?        @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)
  requirements     MotorBoltRequirement[]
  annotations      PositionAnnotation[]
  closeUpPhotos    CloseUpPhoto[]

  @@unique([motorcycleTypeId, name])
  @@index([motorcycleTypeId])
  @@map("bolt_positions")
}

model MotorcycleModel {
  id               Int                  @id @default(autoincrement())
  motorcycleTypeId Int                  @map("motorcycle_type_id")
  modelUrl         String               @map("model_url")
  thumbnailUrl     String?              @map("thumbnail_url")
  scale            Float                @default(1)
  rotationY        Float                @default(0) @map("rotation_y")
  createdAt        DateTime             @default(now()) @map("created_at")
  motorcycleType   MotorcycleType       @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)
  annotations      PositionAnnotation[]

  @@index([motorcycleTypeId])
  @@map("motorcycle_models")
}

model PositionAnnotation {
  id               Int              @id @default(autoincrement())
  boltPositionId   Int              @map("bolt_position_id")
  motorcycleTypeId Int              @map("motorcycle_type_id")
  modelId          Int?             @map("model_id")
  x                Float
  y                Float
  z                Float            @default(0)
  normalX          Float            @default(0) @map("normal_x")
  normalY          Float            @default(0) @map("normal_y")
  normalZ          Float            @default(1) @map("normal_z")
  label            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  boltPosition     BoltPosition     @relation(fields: [boltPositionId], references: [id], onDelete: Cascade)
  motorcycleType   MotorcycleType   @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)
  model            MotorcycleModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([motorcycleTypeId])
  @@index([boltPositionId])
  @@map("position_annotations")
}

model CloseUpPhoto {
  id               Int              @id @default(autoincrement())
  motorcycleTypeId Int              @map("motorcycle_type_id")
  boltPositionId   Int              @map("bolt_position_id")
  imageUrl         String           @map("image_url")
  caption          String?
  createdAt        DateTime         @default(now()) @map("created_at")
  motorcycleType   MotorcycleType   @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)
  boltPosition     BoltPosition     @relation(fields: [boltPositionId], references: [id], onDelete: Cascade)
  pins             CloseUpBoltPin[]

  @@index([motorcycleTypeId])
  @@index([motorcycleTypeId, boltPositionId])
  @@map("close_up_photos")
}

model CloseUpBoltPin {
  id             Int          @id @default(autoincrement())
  closeUpPhotoId Int          @map("close_up_photo_id")
  boltSpecId     Int          @map("bolt_spec_id")
  x              Float
  y              Float
  quantity       Int          @default(1)
  label          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  closeUpPhoto   CloseUpPhoto @relation(fields: [closeUpPhotoId], references: [id], onDelete: Cascade)
  boltSpec       BoltSpec     @relation(fields: [boltSpecId], references: [id], onDelete: Cascade)

  @@index([closeUpPhotoId])
  @@index([boltSpecId])
  @@map("close_up_bolt_pins")
}

model BoltSpec {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique
  diameterMm   Decimal                @map("diameter_mm") @db.Decimal(5, 2)
  lengthMm     Decimal                @map("length_mm") @db.Decimal(6, 2)
  headType     String                 @map("head_type") // Flange Hex, Button, Taper, dll.
  threadPitch  String?                @map("thread_pitch") // e.g. 1.0, 1.25
  material     String                 @default("Titanium Gr5")
  finish       String                 @default("Glossy") // Glossy, Doff
  notes        String?
  requirements MotorBoltRequirement[]
  packageItems PackageItem[]
  sessionItems PickSessionItem[]
  images       BoltImage[]
  closeUpPins  CloseUpBoltPin[]

  @@map("bolt_specs")
}

model BoltImage {
  id         Int      @id @default(autoincrement())
  boltSpecId Int      @map("bolt_spec_id")
  url        String
  caption    String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  boltSpec   BoltSpec @relation(fields: [boltSpecId], references: [id], onDelete: Cascade)

  @@index([boltSpecId])
  @@map("bolt_images")
}

model MotorBoltRequirement {
  id               Int            @id @default(autoincrement())
  motorcycleTypeId Int            @map("motorcycle_type_id")
  boltPositionId   Int            @map("bolt_position_id")
  boltSpecId       Int            @map("bolt_spec_id")
  quantity         Int
  side             String         @default("NONE") // LEFT, RIGHT, FRONT, REAR, NONE
  isOptional       Boolean        @default(false) @map("is_optional")
  sortOrder        Int            @default(0) @map("sort_order")
  notes            String?
  motorcycleType   MotorcycleType @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)
  boltPosition     BoltPosition   @relation(fields: [boltPositionId], references: [id], onDelete: Restrict)
  boltSpec         BoltSpec       @relation(fields: [boltSpecId], references: [id], onDelete: Restrict)
  packageItems     PackageItem[]

  @@unique([motorcycleTypeId, boltPositionId, boltSpecId, side])
  @@map("motor_bolt_requirements")
}

model Package {
  id               Int            @id @default(autoincrement())
  motorcycleTypeId Int            @map("motorcycle_type_id")
  packageType      String         @map("package_type") // Mesin, Bodi, Full Bike
  name             String
  description      String?
  status           String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime       @default(now()) @map("created_at")
  motorcycleType   MotorcycleType @relation(fields: [motorcycleTypeId], references: [id], onDelete: Cascade)
  items            PackageItem[]
  pickSessions     PickSession[]

  @@map("packages")
}

model PackageItem {
  id                  Int                    @id @default(autoincrement())
  packageId           Int                    @map("package_id")
  boltSpecId          Int                    @map("bolt_spec_id")
  sourceRequirementId Int?                   @map("source_requirement_id")
  quantity            Int
  emblemNote          String?                @map("emblem_note")
  package             Package                @relation(fields: [packageId], references: [id], onDelete: Cascade)
  boltSpec            BoltSpec               @relation(fields: [boltSpecId], references: [id], onDelete: Restrict)
  sourceRequirement   MotorBoltRequirement?  @relation(fields: [sourceRequirementId], references: [id], onDelete: SetNull)

  @@map("package_items")
}

model PickSession {
  id               Int               @id @default(autoincrement())
  motorcycleTypeId Int               @map("motorcycle_type_id")
  packageId        Int?              @map("package_id")
  createdBy        Int               @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  status           String            @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  notes            String?
  motorcycleType   MotorcycleType    @relation(fields: [motorcycleTypeId], references: [id], onDelete: Restrict)
  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items            PickSessionItem[]

  @@map("pick_sessions")
}

model PickSessionItem {
  id              Int         @id @default(autoincrement())
  pickSessionId   Int         @map("pick_session_id")
  boltSpecId      Int         @map("bolt_spec_id")
  quantity        Int
  positionSummary String      @map("position_summary") // e.g. "Cover Mesin (4), Kaliper (2)"
  checked         Boolean     @default(false)
  pickSession     PickSession @relation(fields: [pickSessionId], references: [id], onDelete: Cascade)
  boltSpec        BoltSpec    @relation(fields: [boltSpecId], references: [id], onDelete: Restrict)

  @@map("pick_session_items")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   // LOGIN, CREATE, UPDATE, DELETE, IMPORT, RESTORE, PICK_LIST
  entity    String   // MOTORCYCLE, REQUIREMENT, BOLT_SPEC, POSITION, PACKAGE, PICK_SESSION, SYSTEM
  entityId  Int?     @map("entity_id")
  timestamp DateTime @default(now())
  detail    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

