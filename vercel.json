{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run install:all && npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/public/**"
    }
  }
}
